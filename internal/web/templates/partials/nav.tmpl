{{define "nav"}}
<nav class="site-nav" aria-label="Main navigation">
    <ul>
        <li>
            <strong><a class="site-nav__brand contrast" href="/">Book Social</a></strong>
        </li>
    </ul>

    {{if .Nav}}
        <ul class="site-nav__items">
            {{range .Nav}}
                <li>
                    <a href="{{.Href}}"{{if eq $.ActiveNav .Key}} aria-current="page"{{end}}>{{.Label}}</a>
                </li>
            {{end}}
        </ul>
    {{else}}
        <ul class="site-nav__items">
            <li><a href="/">Home</a></li>
        </ul>
    {{end}}

    <ul class="site-nav__items">
        {{if .CurrentUser}}
            <li><a href="/me">{{.CurrentUser.DisplayName}}</a></li>
            <li>
                <form method="post" action="/logout">
                    <button type="submit" class="secondary">Logout</button>
                </form>
            </li>
        {{else}}
            <li><a href="/login">Login</a></li>
            <li><a href="/register">Register</a></li>
        {{end}}
    </ul>
</nav>
{{end}}
