{{define "book_card"}}
    <article class="book-card">
        <a class="book-card__cover {{.CoverClass}}" href="{{.BookURL}}" aria-label="Open {{.Title}}">
            <span class="book-card__cover-book" aria-hidden="true">
                <span class="book-cover__brand">Book Social</span>
                <span class="book-cover__title">{{.Title}}</span>
                <span class="book-cover__rule"></span>
            </span>
        </a>

        <div class="book-card__body">
            <h2 class="book-card__title">
                <a href="{{.BookURL}}">{{.Title}}</a>
            </h2>

            <p class="book-card__meta">
                {{if .Authors}}
                    by
                    {{range $index, $author := .Authors}}
                        {{if $index}}, {{end}}
                        <a href="{{$author.URL}}">{{$author.Name}}</a>
                        {{if and $.UseHTMXFilters $author.FilterURL}}
                            <a href="{{$author.FilterURL}}" hx-get="{{$author.FilterURL}}" hx-target="#book-list" hx-swap="innerHTML" hx-push-url="true" aria-label="Filter catalog by {{$author.Name}}">Filter</a>
                        {{end}}
                    {{end}}
                {{end}}
            </p>

            {{if .Genres}}
                <p class="book-card__genre">
                    {{range $index, $genre := .Genres}}
                        {{if $index}}, {{end}}
                        {{if $.UseHTMXFilters}}
                            <a href="{{$genre.URL}}" hx-get="{{$genre.URL}}" hx-target="#book-list" hx-swap="innerHTML" hx-push-url="true">{{$genre.Name}}</a>
                        {{else}}
                            <a href="{{$genre.URL}}">{{$genre.Name}}</a>
                        {{end}}
                    {{end}}
                </p>
            {{end}}

            {{if .Description}}
                <p class="book-card__description">{{.Description}}</p>
            {{end}}

            {{if .ShowDetailsLink}}
                <p class="book-card__footer">
                    <a href="{{.BookURL}}" aria-label="View details for {{.Title}}">View details</a>
                </p>
            {{end}}
        </div>
    </article>
{{end}}
