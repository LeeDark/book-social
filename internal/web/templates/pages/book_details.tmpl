{{define "title"}}{{.Title}}{{end}}

{{define "main"}}
    <article class="book-details">
        <p class="book-details__back">
            <a href="/books">← Back to catalog</a>
        </p>

        <div class="book-details__layout">
            <div class="book-details__cover" role="img" aria-label="Book cover for {{.Book.Title}}">
                {{template "book_cover" .Book}}
            </div>

            <div class="book-details__body">
                <header class="book-details__header">
                    <h1 class="book-details__title">{{.Book.Title}}</h1>

                    {{if .Book.Authors}}
                        <p class="book-details__meta">
                            by
                            {{range $index, $author := .Book.Authors}}
                                {{if $index}}, {{end}}
                                <a href="{{$author.URL}}">{{$author.Name}}</a>
                            {{end}}
                        </p>
                    {{end}}
                </header>

                {{if .Book.Genres}}
                    <div class="book-details__genres">
                        {{range .Book.Genres}}
                            <a class="book-details__genre" href="{{.URL}}">{{.Name}}</a>
                        {{end}}
                    </div>
                {{end}}

                {{if .Book.Description}}
                    <section class="book-details__description">
                        <h2>Description</h2>
                        <p>{{.Book.Description}}</p>
                    </section>
                {{end}}

                {{if .Book.LibraryState}}
                    <p><strong>{{.Book.LibraryState.Label}}</strong> in <a href="/me/library">your library</a>.</p>
                {{else if .Book.CanAddToLibrary}}
                    <form method="post" action="/me/library">
                        <input type="hidden" name="book_slug" value="{{.Book.Slug}}">
                        <button type="submit">Add to my library</button>
                    </form>
                {{end}}
            </div>
        </div>
    </article>
{{end}}
