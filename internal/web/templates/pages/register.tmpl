{{define "title"}}{{.Title}}{{end}}
{{define "main"}}
<section aria-labelledby="register-heading">
    <h1 id="register-heading">Create your account</h1>
    <form method="post" action="/register" novalidate>
        <label for="first_name">First name</label>
        <input id="first_name" name="first_name" autocomplete="given-name" value="{{.Form.FirstName}}" aria-describedby="first_name-error">
        {{with index .Form.Errors "first_name"}}<small id="first_name-error">{{.}}</small>{{end}}
        <label for="login">Login</label>
        <input id="login" name="login" autocomplete="username" value="{{.Form.Login}}" aria-describedby="login-error">
        {{with index .Form.Errors "login"}}<small id="login-error">{{.}}</small>{{end}}
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" value="{{.Form.Email}}" aria-describedby="email-error">
        {{with index .Form.Errors "email"}}<small id="email-error">{{.}}</small>{{end}}
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" aria-describedby="password-error">
        {{with index .Form.Errors "password"}}<small id="password-error">{{.}}</small>{{end}}
        <label for="password_confirmation">Confirm password</label>
        <input id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password" aria-describedby="password_confirmation-error">
        {{with index .Form.Errors "password_confirmation"}}<small id="password_confirmation-error">{{.}}</small>{{end}}
        <button type="submit">Register</button>
    </form>
</section>
{{end}}
